{
  "description": "Plays an 8-bit sound when Claude finishes, needs you, or hits a rate limit.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/play.sh\" done --stop-hook",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "^(?!idle_prompt$)",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/play.sh\" attention",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/play.sh\" limit",
            "async": true
          }
        ]
      }
    ]
  }
}
